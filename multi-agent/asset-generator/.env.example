# Azure OpenAI endpoint for image generation (gpt-image-1.5)
AZURE_OPENAI_IMAGE_ENDPOINT=https://sw-v2-project-resource.openai.azure.com/openai/v1/
# Model deployment name
AZURE_OPENAI_IMAGE_MODEL=gpt-image-1.5
# Output directory for generated icons (relative to this folder)
OUTPUT_DIR=../frontend/src/assets/icons
